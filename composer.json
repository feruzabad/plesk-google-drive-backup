{
    "name": "feruzabad/plesk-google-drive-backup",
    "description": "Open-source Plesk extension that adds Google Drive as a remote backup storage.",
    "type": "project",
    "license": "MIT",
    "homepage": "https://github.com/feruzabad/plesk-google-drive-backup",
    "support": {
        "issues": "https://github.com/feruzabad/plesk-google-drive-backup/issues",
        "source": "https://github.com/feruzabad/plesk-google-drive-backup"
    },
    "authors": [
        {
            "name": "feruzabad",
            "homepage": "https://github.com/feruzabad"
        }
    ],
    "keywords": [
        "plesk",
        "plesk-extension",
        "backup",
        "google-drive",
        "gdrive"
    ],
    "require": {
        "php": "^8.4",
        "google/apiclient": "^2.20",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5",
        "plesk/pm-api-stubs": "^18.0"
    },
    "autoload-dev": {
        "classmap": [
            "src/plib/library"
        ]
    },
    "config": {
        "platform": {
            "php": "8.4.0"
        },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --no-progress --memory-limit=1G",
        "build": "bash scripts/build.sh"
    }
}
